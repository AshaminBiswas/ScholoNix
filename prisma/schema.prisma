// =============================================================================
// STUDENT MANAGEMENT & ACADEMIC LIFECYCLE MODELS (STRICTLY TENANT-SCOPED)
// =============================================================================

enum StudentLifecycleStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
  ALUMNI
  WITHDRAWN
}

enum StudentEnrollmentStatus {
  ENROLLED
  PROMOTED
  RETAINED
  TRANSFERRED_OUT
  GRADUATED
}

enum StudentTransferType {
  TRANSFER_IN
  TRANSFER_OUT
}

model Student {
  id                  String                 @id @default(uuid()) @db.Uuid
  schoolId            String                 @map("school_id") @db.Uuid
  applicationId       String?                @unique @map("application_id") @db.Uuid
  userId              String?                @map("user_id") @db.Uuid
  admissionNumber     String                 @map("admission_number") @db.VarChar(40)
  studentIdNumber     String?                @map("student_id_number") @db.VarChar(60)
  studentName         String                 @map("student_name") @db.VarChar(255)
  gender              String?                @db.VarChar(30)
  dateOfBirth         DateTime?              @map("date_of_birth") @db.Date
  bloodGroup          String?                @map("blood_group") @db.VarChar(20)
  nationality         String?                @db.VarChar(80)
  photoKey            String?                @map("photo_key") @db.VarChar(500)
  email               String?                @db.VarChar(255)
  phone               String?                @db.VarChar(30)
  addressJson         Json?                  @map("address_json") @db.JsonB
  guardianName        String                 @map("guardian_name") @db.VarChar(255)
  guardianRelation    String                 @default("Parent") @map("guardian_relation") @db.VarChar(60)
  guardianPhone       String                 @map("guardian_phone") @db.VarChar(30)
  guardianEmail       String?                @map("guardian_email") @db.VarChar(255)
  guardianDetails     Json?                  @map("guardian_details") @db.JsonB
  previousSchool      String?                @map("previous_school") @db.VarChar(255)
  academicDetails     Json?                  @map("academic_details") @db.JsonB
  medicalNotes        String?                @map("medical_notes") @db.Text
  admissionType       AdmissionType          @default(FRESH) @map("admission_type")
  admissionDate       DateTime               @default(now()) @map("admission_date") @db.Timestamptz(6)
  status              StudentLifecycleStatus @default(ACTIVE)
  currentAcademicYear String                 @map("current_academic_year") @db.VarChar(30)
  currentGrade        String                 @map("current_grade") @db.VarChar(60)
  currentSection      String                 @default("A") @map("current_section") @db.VarChar(20)
  currentRollNumber   String?                @map("current_roll_number") @db.VarChar(30)
  graduationYear      String?                @map("graduation_year") @db.VarChar(30)
  inactiveReason      String?                @map("inactive_reason") @db.VarChar(255)
  profileExtended     Json?                  @map("profile_extended") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school                 School                        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  application            AdmissionApplication?         @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  enrollments            StudentEnrollment[]
  transfers              StudentTransfer[]
  groupMembers           StudentGroupMember[]
  activities             StudentActivity[]
  attendanceRecords      StudentAttendanceRecord[]
  examResults            StudentExamResult[]
  studentDocuments       StudentDocument[]
  communications         StudentCommunication[]
  homeworkItems          StudentHomeworkItem[]
  coCurricularActivities StudentCoCurricularActivity[]
  notesRemarks           StudentNoteRemark[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId, status, currentGrade, currentSection])
  @@index([schoolId, currentAcademicYear, currentGrade])
  @@index([schoolId, admissionDate])
  @@map("students")
}

model StudentEnrollment {
  id                       String                  @id @default(uuid()) @db.Uuid
  schoolId                 String                  @map("school_id") @db.Uuid
  studentId                String                  @map("student_id") @db.Uuid
  academicYear             String                  @map("academic_year") @db.VarChar(30)
  grade                    String                  @db.VarChar(60)
  section                  String                  @default("A") @db.VarChar(20)
  rollNumber               String?                 @map("roll_number") @db.VarChar(30)
  status                   StudentEnrollmentStatus @default(ENROLLED)
  isCurrent                Boolean                 @default(true) @map("is_current")
  promotedFromEnrollmentId String?                 @map("promoted_from_enrollment_id") @db.Uuid
  remarks                  String?                 @db.VarChar(255)
  effectiveFrom            DateTime                @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo              DateTime?               @map("effective_to") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, studentId, academicYear])
  @@index([schoolId, academicYear, grade, section])
  @@index([studentId, isCurrent])
  @@map("student_enrollments")
}

model StudentTransfer {
  id                        String              @id @default(uuid()) @db.Uuid
