// =============================================================================
// School Management SaaS — Prisma Schema Foundation
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// TENANT / INSTITUTION MODELS
// =============================================================================

enum SchoolStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  INACTIVE
}

model School {
  id               String       @id @default(uuid()) @db.Uuid
  name             String       @db.VarChar(255)
  slug             String       @unique @db.VarChar(100)
  code             String?      @unique @db.VarChar(50)
  category         String       @default("Co-Educational School") @db.VarChar(100)
  affiliationBoard String?      @map("affiliation_board") @db.VarChar(100)
  contactPhone     String       @map("contact_phone") @db.VarChar(20)
  contactEmail     String?      @map("contact_email") @db.VarChar(255)
  website          String?      @db.VarChar(255)
  addressLine      String       @map("address_line") @db.VarChar(255)
  locality         String?      @db.VarChar(255)
  city             String       @db.VarChar(100)
  state            String       @db.VarChar(100)
  pinCode          String       @map("pin_code") @db.VarChar(20)
  country          String       @default("India") @db.VarChar(100)
  logoUrl          String?      @map("logo_url") @db.Text
  status           SchoolStatus @default(TRIAL)
  onboardingStep   Int          @default(1) @map("onboarding_step")
  onboardingDone   Boolean      @default(false) @map("onboarding_done")
  trialEndsAt      DateTime?    @map("trial_ends_at") @db.Timestamptz(6)
  parentSchoolId   String?      @map("parent_school_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  parentSchool          School?                @relation("SchoolHierarchy", fields: [parentSchoolId], references: [id], onDelete: SetNull)
  branches              School[]               @relation("SchoolHierarchy")
  users                 User[]
  auditLogs             AuditLog[]
  admissionSetting      AdmissionSetting?
  admissionEnquiries    AdmissionEnquiry[]
  admissionApplications AdmissionApplication[]
  admissionReminders    AdmissionReminder[]
  admissionActivities   AdmissionActivity[]

  @@index([status])
  @@index([slug])
  @@map("schools")
}

// =============================================================================
// USER & IDENTITY MODELS
// =============================================================================

enum UserRole {
  PLATFORM_SUPER_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  TEACHER
  ACCOUNTANT
  STAFF
  PARENT
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  PENDING_VERIFICATION
}

model User {
  id              String      @id @default(uuid()) @db.Uuid
  schoolId        String?     @map("school_id") @db.Uuid
  name            String      @db.VarChar(255)
  email           String?     @db.VarChar(255)
  phone           String      @db.VarChar(20)
  passwordHash    String      @map("password_hash") @db.VarChar(255)
  role            UserRole    @default(SCHOOL_ADMIN)
  status          UserStatus  @default(PENDING_VERIFICATION)
  phoneVerified   Boolean     @default(false) @map("phone_verified")
  emailVerified   Boolean     @default(false) @map("email_verified")
  phoneVerifiedAt DateTime?   @map("phone_verified_at") @db.Timestamptz(6)
  emailVerifiedAt DateTime?   @map("email_verified_at") @db.Timestamptz(6)
  phoneVerificationProvider String? @default("SMS_OTP") @map("phone_verification_provider") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school           School?                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  auditLogs        AuditLog[]
  sessions         UserSession[]
  otpVerifications OtpVerification[]
  passwordResets   PasswordResetRequest[]

  @@unique([phone, schoolId])
  @@index([email])
  @@index([phone])
  @@index([schoolId])
  @@index([status])
  @@map("users")
}

// =============================================================================
// OTP VERIFICATION MODELS
// =============================================================================

enum OtpChannel {
  EMAIL
  SMS
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
  PASSWORD_RESET
}

model OtpVerification {
  id          String      @id @default(uuid()) @db.Uuid
  identifier  String      @db.VarChar(255) // normalized phone or email
  channel     OtpChannel
  purpose     OtpPurpose  @default(REGISTRATION)
  codeHash    String      @map("code_hash") @db.VarChar(255)
  attempts    Int         @default(0)
  maxAttempts Int         @default(5) @map("max_attempts")
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz(6)
  resendAfter DateTime    @map("resend_after") @db.Timestamptz(6)
  verifiedAt  DateTime?   @map("verified_at") @db.Timestamptz(6)
  metadata    Json?       @db.JsonB
  userId      String?     @map("user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, purpose, channel])
  @@index([expiresAt])
  @@map("otp_verifications")
}

// Legacy table alias for backwards compatibility
model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String    @db.VarChar(20)
  codeHash   String    @map("code_hash") @db.VarChar(255)
  purpose    String    @default("REGISTRATION") @db.VarChar(50)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  attempts   Int       @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, purpose])
  @@map("otp_challenges")
}

// =============================================================================
// SESSION MANAGEMENT MODELS
// =============================================================================

model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.Text
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("user_sessions")
}

// =============================================================================
// PASSWORD RESET MODELS
// =============================================================================

model PasswordResetRequest {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  resetTokenHash String    @unique @map("reset_token_hash") @db.VarChar(255)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resetTokenHash])
  @@map("password_reset_requests")
}

// =============================================================================
// RATE LIMITING MODEL
// =============================================================================

model RateLimitRecord {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(255)
  points    Int      @default(0)
  resetAt   DateTime @map("reset_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([key, resetAt])
  @@map("rate_limit_records")
}

// =============================================================================
// AUDIT LOGGING
// =============================================================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String?  @map("school_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String   @map("entity_id") @db.VarChar(255)
  metadata   Json?    @db.JsonB
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

// =============================================================================
// ADMISSIONS MANAGEMENT MODELS (STRICTLY TENANT-SCOPED)
// =============================================================================

enum AdmissionEnquiryStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  CONVERTED
  CLOSED
}

enum AdmissionApplicationStatus {
  UNDER_REVIEW
  DOCUMENTS_PENDING
  SHORTLISTED
  ADMITTED
  REJECTED
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AdmissionReminderPriority {
  INFO
  WARNING
}

model AdmissionSetting {
  id                  String    @id @default(uuid()) @db.Uuid
  schoolId            String    @unique @map("school_id") @db.Uuid
  currentAcademicYear String    @map("current_academic_year") @db.VarChar(30)
  applicationDeadline DateTime? @map("application_deadline") @db.Timestamptz(6)
  applicationPrefix   String    @default("APP") @map("application_prefix") @db.VarChar(16)
  nextApplicationSeq  Int       @default(1) @map("next_application_seq")
  nextEnquirySeq      Int       @default(1) @map("next_enquiry_seq")
  nextAdmissionSeq    Int       @default(1) @map("next_admission_seq")
  enabledGrades       String[]  @map("enabled_grades")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("admission_settings")
}

model AdmissionEnquiry {
  id                     String                 @id @default(uuid()) @db.Uuid
  schoolId               String                 @map("school_id") @db.Uuid
  enquiryCode            String                 @map("enquiry_code") @db.VarChar(40)
  studentName            String                 @map("student_name") @db.VarChar(255)
  guardianName           String                 @map("guardian_name") @db.VarChar(255)
  guardianPhone          String                 @map("guardian_phone") @db.VarChar(30)
  guardianEmail          String?                @map("guardian_email") @db.VarChar(255)
  gradeApplied           String                 @map("grade_applied") @db.VarChar(60)
  academicYear           String                 @map("academic_year") @db.VarChar(30)
  source                 String                 @default("Walk-In") @db.VarChar(60)
  status                 AdmissionEnquiryStatus @default(NEW)
  notes                  String?                @db.Text
  convertedApplicationId String?                @map("converted_application_id") @db.Uuid
  createdByUserId        String?                @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, enquiryCode])
  @@index([schoolId, academicYear, status, createdAt])
  @@map("admission_enquiries")
}

model AdmissionApplication {
  id                 String                     @id @default(uuid()) @db.Uuid
  schoolId           String                     @map("school_id") @db.Uuid
  applicationCode    String                     @map("application_code") @db.VarChar(40)
  admissionNumber    String?                    @map("admission_number") @db.VarChar(40)
  enquiryId          String?                    @map("enquiry_id") @db.Uuid
  studentName        String                     @map("student_name") @db.VarChar(255)
  gender             String?                    @db.VarChar(30)
  dateOfBirth        DateTime?                  @map("date_of_birth") @db.Date
  gradeApplied       String                     @map("grade_applied") @db.VarChar(60)
  academicYear       String                     @map("academic_year") @db.VarChar(30)
  guardianName       String                     @map("guardian_name") @db.VarChar(255)
  guardianRelation   String                     @default("Parent") @map("guardian_relation") @db.VarChar(60)
  guardianPhone      String                     @map("guardian_phone") @db.VarChar(30)
  guardianEmail      String?                    @map("guardian_email") @db.VarChar(255)
  previousSchool     String?                    @map("previous_school") @db.VarChar(255)
  status             AdmissionApplicationStatus @default(UNDER_REVIEW)
  verificationStatus DocumentVerificationStatus @default(PENDING) @map("verification_status")
  verificationNotes  String?                    @map("verification_notes") @db.Text
  documentsChecklist Json                       @map("documents_checklist") @db.JsonB
  appliedAt          DateTime                   @default(now()) @map("applied_at") @db.Timestamptz(6)
  shortlistedAt      DateTime?                  @map("shortlisted_at") @db.Timestamptz(6)
  admittedAt         DateTime?                  @map("admitted_at") @db.Timestamptz(6)
  rejectedAt         DateTime?                  @map("rejected_at") @db.Timestamptz(6)
  verifiedAt         DateTime?                  @map("verified_at") @db.Timestamptz(6)
  reviewedByUserId   String?                    @map("reviewed_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, applicationCode])
  @@unique([schoolId, admissionNumber])
  @@index([schoolId, academicYear, status, appliedAt])
  @@index([schoolId, academicYear, gradeApplied])
  @@index([schoolId, appliedAt])
  @@map("admission_applications")
}

model AdmissionReminder {
  id              String                    @id @default(uuid()) @db.Uuid
  schoolId        String                    @map("school_id") @db.Uuid
  title           String                    @db.VarChar(255)
  academicYear    String?                   @map("academic_year") @db.VarChar(30)
  dueDate         DateTime?                 @map("due_date") @db.Timestamptz(6)
  priority        AdmissionReminderPriority @default(INFO)
  isCompleted     Boolean                   @default(false) @map("is_completed")
  createdByUserId String?                   @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, academicYear, isCompleted, createdAt])
  @@map("admission_reminders")
}

model AdmissionActivity {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  applicationId String?  @map("application_id") @db.Uuid
  enquiryId     String?  @map("enquiry_id") @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  actorName     String   @map("actor_name") @db.VarChar(255)
  action        String   @db.VarChar(80)
  summary       String   @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@map("admission_activities")
}
