// =============================================================================
// School Management SaaS — Prisma Schema Foundation
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// TENANT / INSTITUTION MODELS
// =============================================================================

enum SchoolStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  INACTIVE
}

model School {
  id               String       @id @default(uuid()) @db.Uuid
  name             String       @db.VarChar(255)
  slug             String       @unique @db.VarChar(100)
  uniqueId         String?      @unique @map("unique_id") @db.VarChar(32)
  code             String?      @unique @db.VarChar(50)
  category         String       @default("Co-Educational School") @db.VarChar(100)
  affiliationBoard String?      @map("affiliation_board") @db.VarChar(100)
  contactPhone     String       @map("contact_phone") @db.VarChar(20)
  contactEmail     String?      @map("contact_email") @db.VarChar(255)
  website          String?      @db.VarChar(255)
  addressLine      String       @map("address_line") @db.VarChar(255)
  locality         String?      @db.VarChar(255)
  city             String       @db.VarChar(100)
  state            String       @db.VarChar(100)
  pinCode          String       @map("pin_code") @db.VarChar(20)
  country          String       @default("India") @db.VarChar(100)
  logoUrl          String?      @map("logo_url") @db.Text
  status           SchoolStatus @default(TRIAL)
  onboardingStep   Int          @default(1) @map("onboarding_step")
  onboardingDone   Boolean      @default(false) @map("onboarding_done")
  trialEndsAt      DateTime?    @map("trial_ends_at") @db.Timestamptz(6)
  parentSchoolId   String?      @map("parent_school_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  parentSchool          School?                @relation("SchoolHierarchy", fields: [parentSchoolId], references: [id], onDelete: SetNull)
  branches              School[]               @relation("SchoolHierarchy")
  users                 User[]
  auditLogs             AuditLog[]
  admissionSetting              AdmissionSetting?
  admissionEnquiries            AdmissionEnquiry[]
  admissionEnquirySources       AdmissionEnquirySource[]
  admissionEnquiryFollowUps     AdmissionEnquiryFollowUp[]
  admissionEnquiryCommunications AdmissionEnquiryCommunication[]
  admissionEnquiryNotes         AdmissionEnquiryNote[]
  admissionApplications         AdmissionApplication[]
  admissionReminders            AdmissionReminder[]
  admissionActivities           AdmissionActivity[]
  admissionFeeLedgers           AdmissionFeeLedger[]
  admissionFeePayments          AdmissionFeePayment[]

  @@index([status])
  @@index([slug])
  @@index([uniqueId])
  @@map("schools")
}

// =============================================================================
// USER & IDENTITY MODELS
// =============================================================================

enum UserRole {
  PLATFORM_SUPER_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  TEACHER
  ACCOUNTANT
  STAFF
  PARENT
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  PENDING_VERIFICATION
}

model User {
  id              String      @id @default(uuid()) @db.Uuid
  schoolId        String?     @map("school_id") @db.Uuid
  name            String      @db.VarChar(255)
  email           String?     @db.VarChar(255)
  phone           String      @db.VarChar(20)
  passwordHash    String      @map("password_hash") @db.VarChar(255)
  role            UserRole    @default(SCHOOL_ADMIN)
  status          UserStatus  @default(PENDING_VERIFICATION)
  phoneVerified   Boolean     @default(false) @map("phone_verified")
  emailVerified   Boolean     @default(false) @map("email_verified")
  phoneVerifiedAt DateTime?   @map("phone_verified_at") @db.Timestamptz(6)
  emailVerifiedAt DateTime?   @map("email_verified_at") @db.Timestamptz(6)
  phoneVerificationProvider String? @default("SMS_OTP") @map("phone_verification_provider") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school           School?                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  auditLogs        AuditLog[]
  sessions         UserSession[]
  otpVerifications OtpVerification[]
  passwordResets   PasswordResetRequest[]

  @@unique([phone, schoolId])
  @@index([email])
  @@index([phone])
  @@index([schoolId])
  @@index([status])
  @@map("users")
}

// =============================================================================
// OTP VERIFICATION MODELS
// =============================================================================

enum OtpChannel {
  EMAIL
  SMS
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
  PASSWORD_RESET
}

model OtpVerification {
  id          String      @id @default(uuid()) @db.Uuid
  identifier  String      @db.VarChar(255) // normalized phone or email
  channel     OtpChannel
  purpose     OtpPurpose  @default(REGISTRATION)
  codeHash    String      @map("code_hash") @db.VarChar(255)
  attempts    Int         @default(0)
  maxAttempts Int         @default(5) @map("max_attempts")
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz(6)
  resendAfter DateTime    @map("resend_after") @db.Timestamptz(6)
  verifiedAt  DateTime?   @map("verified_at") @db.Timestamptz(6)
  metadata    Json?       @db.JsonB
  userId      String?     @map("user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, purpose, channel])
  @@index([expiresAt])
  @@map("otp_verifications")
}

// Legacy table alias for backwards compatibility
model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String    @db.VarChar(20)
  codeHash   String    @map("code_hash") @db.VarChar(255)
  purpose    String    @default("REGISTRATION") @db.VarChar(50)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  attempts   Int       @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, purpose])
  @@map("otp_challenges")
}

// =============================================================================
// SESSION MANAGEMENT MODELS
// =============================================================================

model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.Text
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("user_sessions")
}

// =============================================================================
// PASSWORD RESET MODELS
// =============================================================================

model PasswordResetRequest {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  resetTokenHash String    @unique @map("reset_token_hash") @db.VarChar(255)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resetTokenHash])
  @@map("password_reset_requests")
}

// =============================================================================
// RATE LIMITING MODEL
// =============================================================================

model RateLimitRecord {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(255)
  points    Int      @default(0)
  resetAt   DateTime @map("reset_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([key, resetAt])
  @@map("rate_limit_records")
}

// =============================================================================
// AUDIT LOGGING
// =============================================================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String?  @map("school_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String   @map("entity_id") @db.VarChar(255)
  metadata   Json?    @db.JsonB
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

// =============================================================================
// ADMISSIONS MANAGEMENT MODELS (STRICTLY TENANT-SCOPED)
// =============================================================================

enum AdmissionEnquiryStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  CONVERTED
  CLOSED
}

enum AdmissionApplicationStatus {
  UNDER_REVIEW
  DOCUMENTS_PENDING
  SHORTLISTED
  ADMITTED
  REJECTED
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AdmissionReminderPriority {
  INFO
  WARNING
}

enum AdmissionType {
  FRESH
  TRANSFER
  RE_ADMISSION
  OTHER
}

model AdmissionSetting {
  id                  String    @id @default(uuid()) @db.Uuid
  schoolId            String    @unique @map("school_id") @db.Uuid
  currentAcademicYear String    @map("current_academic_year") @db.VarChar(30)
  applicationDeadline DateTime? @map("application_deadline") @db.Timestamptz(6)
  applicationPrefix   String    @default("APP") @map("application_prefix") @db.VarChar(16)
  nextApplicationSeq  Int       @default(1) @map("next_application_seq")
  nextEnquirySeq      Int       @default(1) @map("next_enquiry_seq")
  nextAdmissionSeq    Int       @default(1) @map("next_admission_seq")
  nextReceiptSeq      Int       @default(1) @map("next_receipt_seq")
  enabledGrades       String[]  @map("enabled_grades")
  extendedConfig      Json?     @map("extended_config")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("admission_settings")
}

model AdmissionEnquiry {
  id                     String                 @id @default(uuid()) @db.Uuid
  schoolId               String                 @map("school_id") @db.Uuid
  enquiryCode            String                 @map("enquiry_code") @db.VarChar(40)
  enquiryDate            DateTime               @default(now()) @map("enquiry_date") @db.Timestamptz(6)
  studentName            String                 @map("student_name") @db.VarChar(255)
  studentDob             String?                @map("student_dob") @db.VarChar(20)
  studentGender          String?                @map("student_gender") @db.VarChar(20)
  guardianName           String                 @map("guardian_name") @db.VarChar(255)
  guardianRelation       String?                @map("guardian_relation") @db.VarChar(60)
  guardianPhone          String                 @map("guardian_phone") @db.VarChar(30)
  guardianEmail          String?                @map("guardian_email") @db.VarChar(255)
  addressLine1           String?                @map("address_line_1") @db.VarChar(255)
  addressLine2           String?                @map("address_line_2") @db.VarChar(255)
  city                   String?                @db.VarChar(100)
  state                  String?                @db.VarChar(100)
  pinCode                String?                @map("pin_code") @db.VarChar(20)
  gradeApplied           String                 @map("grade_applied") @db.VarChar(60)
  academicYear           String                 @map("academic_year") @db.VarChar(30)
  source                 String                 @default("Walk-In") @db.VarChar(60)
  enquiryType            String                 @default("General") @map("enquiry_type") @db.VarChar(60)
  status                 AdmissionEnquiryStatus @default(NEW)
  assignedToUserId       String?                @map("assigned_to_user_id") @db.Uuid
  assignedToName         String?                @map("assigned_to_name") @db.VarChar(255)
  nextFollowUpAt         DateTime?              @map("next_follow_up_at") @db.Timestamptz(6)
  hasSiblingsInSchool    Boolean                @default(false) @map("has_siblings_in_school")
  interestedInTransport  Boolean                @default(false) @map("interested_in_transport")
  interestedInHostel     Boolean                @default(false) @map("interested_in_hostel")
  requiresSpecialSupport Boolean                @default(false) @map("requires_special_support")
  isDraft                Boolean                @default(false) @map("is_draft")
  notes                  String?                @db.Text
  convertedApplicationId String?                @map("converted_application_id") @db.Uuid
  createdByUserId        String?                @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school         School                          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  followUps      AdmissionEnquiryFollowUp[]
  communications AdmissionEnquiryCommunication[]
  enquiryNotes   AdmissionEnquiryNote[]

  @@unique([schoolId, enquiryCode])
  @@index([schoolId, academicYear, status, createdAt])
  @@index([schoolId, isDraft, updatedAt])
  @@map("admission_enquiries")
}

model AdmissionEnquirySource {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  colorToken  String   @default("violet") @map("color_token") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@map("admission_enquiry_sources")
}

model AdmissionEnquiryFollowUp {
  id               String    @id @default(uuid()) @db.Uuid
  schoolId         String    @map("school_id") @db.Uuid
  enquiryId        String    @map("enquiry_id") @db.Uuid
  followUpType     String    @map("follow_up_type") @db.VarChar(40)
  scheduledAt      DateTime  @map("scheduled_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  status           String    @default("UPCOMING") @db.VarChar(30)
  assignedToUserId String?   @map("assigned_to_user_id") @db.Uuid
  assignedToName   String?   @map("assigned_to_name") @db.VarChar(255)
  notes            String    @db.Text
  outcome          String?   @db.Text
  createdByUserId  String?   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  school  School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enquiry AdmissionEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([schoolId, enquiryId, scheduledAt])
  @@index([schoolId, status, scheduledAt])
  @@map("admission_enquiry_follow_ups")
}

model AdmissionEnquiryCommunication {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  enquiryId    String   @map("enquiry_id") @db.Uuid
  channel      String   @db.VarChar(30)
  recipient    String   @db.VarChar(255)
  cc           String?  @db.VarChar(255)
  bcc          String?  @db.VarChar(255)
  subject      String   @db.VarChar(255)
  message      String   @db.Text
  attachments  Json?
  status       String   @default("SENT") @db.VarChar(30)
  sentByUserId String?  @map("sent_by_user_id") @db.Uuid
  sentByName   String   @map("sent_by_name") @db.VarChar(255)
  sentAt       DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  school  School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enquiry AdmissionEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([schoolId, enquiryId, sentAt])
  @@map("admission_enquiry_communications")
}

model AdmissionEnquiryNote {
  id              String   @id @default(uuid()) @db.Uuid
  schoolId        String   @map("school_id") @db.Uuid
  enquiryId       String   @map("enquiry_id") @db.Uuid
  category        String   @default("Admission Related") @db.VarChar(60)
  title           String   @db.VarChar(180)
  content         String   @db.Text
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdByName   String   @map("created_by_name") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school  School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enquiry AdmissionEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([schoolId, enquiryId, createdAt])
  @@map("admission_enquiry_notes")
}

model AdmissionApplication {
  id                 String                     @id @default(uuid()) @db.Uuid
  schoolId           String                     @map("school_id") @db.Uuid
  applicationCode    String                     @map("application_code") @db.VarChar(40)
  admissionNumber    String?                    @map("admission_number") @db.VarChar(40)
  enquiryId          String?                    @map("enquiry_id") @db.Uuid
  studentName        String                     @map("student_name") @db.VarChar(255)
  gender             String?                    @db.VarChar(30)
  dateOfBirth        DateTime?                  @map("date_of_birth") @db.Date
  gradeApplied       String                     @map("grade_applied") @db.VarChar(60)
  academicYear       String                     @map("academic_year") @db.VarChar(30)
  guardianName       String                     @map("guardian_name") @db.VarChar(255)
  guardianRelation   String                     @default("Parent") @map("guardian_relation") @db.VarChar(60)
  guardianPhone      String                     @map("guardian_phone") @db.VarChar(30)
  guardianEmail      String?                    @map("guardian_email") @db.VarChar(255)
  previousSchool     String?                    @map("previous_school") @db.VarChar(255)
  status             AdmissionApplicationStatus @default(UNDER_REVIEW)
  verificationStatus DocumentVerificationStatus @default(PENDING) @map("verification_status")
  verificationNotes  String?                    @map("verification_notes") @db.Text
  documentsChecklist  Json                       @map("documents_checklist") @db.JsonB
  admissionType       AdmissionType              @default(FRESH) @map("admission_type")
  enrollmentStatus    String                     @default("ACTIVE") @map("enrollment_status") @db.VarChar(30)
  isDraft             Boolean                    @default(false) @map("is_draft")
  currentStep        Int                        @default(1) @map("current_step")
  studentPhotoKey    String?                    @map("student_photo_key") @db.VarChar(500)
  nationality        String?                    @db.VarChar(80)
  bloodGroup         String?                    @map("blood_group") @db.VarChar(20)
  studentIdNumber    String?                    @map("student_id_number") @db.VarChar(60)
  studentDetails     Json?                      @map("student_details") @db.JsonB
  guardianDetails    Json?                      @map("guardian_details") @db.JsonB
  academicDetails    Json?                      @map("academic_details") @db.JsonB
  uploadedDocuments  Json?                      @map("uploaded_documents") @db.JsonB
  declarationAccepted Boolean                   @default(false) @map("declaration_accepted")
  appliedAt          DateTime                   @default(now()) @map("applied_at") @db.Timestamptz(6)
  shortlistedAt      DateTime?                  @map("shortlisted_at") @db.Timestamptz(6)
  admittedAt         DateTime?                  @map("admitted_at") @db.Timestamptz(6)
  rejectedAt         DateTime?                  @map("rejected_at") @db.Timestamptz(6)
  verifiedAt         DateTime?                  @map("verified_at") @db.Timestamptz(6)
  reviewedByUserId   String?                    @map("reviewed_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school      School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeLedger   AdmissionFeeLedger?
  feePayments AdmissionFeePayment[]

  @@unique([schoolId, applicationCode])
  @@unique([schoolId, admissionNumber])
  @@index([schoolId, academicYear, status, appliedAt])
  @@index([schoolId, isDraft, updatedAt])
  @@index([schoolId, academicYear, gradeApplied])
  @@index([schoolId, appliedAt])
  @@map("admission_applications")
}

model AdmissionFeeLedger {
  id               String   @id @default(uuid()) @db.Uuid
  schoolId         String   @map("school_id") @db.Uuid
  applicationId    String   @unique @map("application_id") @db.Uuid
  academicYear     String   @map("academic_year") @db.VarChar(30)
  totalFeePaise    Int      @default(0) @map("total_fee_paise")
  concessionPaise  Int      @default(0) @map("concession_paise")
  concessionReason String?  @map("concession_reason") @db.VarChar(255)
  currency         String   @default("INR") @db.VarChar(10)
  updatedByUserId  String?  @map("updated_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([schoolId, applicationId])
  @@index([schoolId, academicYear])
  @@map("admission_fee_ledgers")
}

model AdmissionFeePayment {
  id               String   @id @default(uuid()) @db.Uuid
  schoolId         String   @map("school_id") @db.Uuid
  applicationId    String   @map("application_id") @db.Uuid
  receiptNumber    String   @map("receipt_number") @db.VarChar(40)
  idempotencyKey   String   @map("idempotency_key") @db.VarChar(80)
  feeHead          String   @map("fee_head") @db.VarChar(80)
  amountPaise      Int      @map("amount_paise")
  paymentDate      DateTime @map("payment_date") @db.Timestamptz(6)
  paymentMode      String   @map("payment_mode") @db.VarChar(40)
  referenceNo      String?  @map("reference_no") @db.VarChar(120)
  remarks          String?  @db.VarChar(255)
  recordedByUserId String?  @map("recorded_by_user_id") @db.Uuid
  recordedByName   String   @map("recorded_by_name") @db.VarChar(255)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([schoolId, receiptNumber])
  @@unique([schoolId, idempotencyKey])
  @@index([schoolId, applicationId, paymentDate])
  @@map("admission_fee_payments")
}

model AdmissionReminder {
  id              String                    @id @default(uuid()) @db.Uuid
  schoolId        String                    @map("school_id") @db.Uuid
  title           String                    @db.VarChar(255)
  academicYear    String?                   @map("academic_year") @db.VarChar(30)
  dueDate         DateTime?                 @map("due_date") @db.Timestamptz(6)
  priority        AdmissionReminderPriority @default(INFO)
  isCompleted     Boolean                   @default(false) @map("is_completed")
  createdByUserId String?                   @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, academicYear, isCompleted, createdAt])
  @@map("admission_reminders")
}

model AdmissionActivity {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  applicationId String?  @map("application_id") @db.Uuid
  enquiryId     String?  @map("enquiry_id") @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  actorName     String   @map("actor_name") @db.VarChar(255)
  action        String   @db.VarChar(80)
  summary       String   @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@map("admission_activities")
}
