  targetPlan      SaaSPlan?                    @map("target_plan")
  targetSchoolId  String?                      @map("target_school_id") @db.Uuid
  isActive        Boolean                      @default(true) @map("is_active")
  startsAt        DateTime                     @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime?                    @map("ends_at") @db.Timestamptz(6)
  createdByUserId String?                      @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  targetSchool School? @relation(fields: [targetSchoolId], references: [id], onDelete: Cascade)

  @@index([isActive, startsAt, endsAt])
  @@map("platform_announcements")
}

// =============================================================================
// DEDICATED COMPANY ADMIN & PLATFORM TEAM TABLES (ISOLATED FROM SCHOOL USERS)
// =============================================================================

enum PlatformAdminRole {
  SUPER_ADMIN
  OPERATIONS
  BILLING_MANAGER
  SUPPORT_AGENT
}

enum PlatformAdminStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model PlatformAdmin {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @db.VarChar(255)
  email              String              @unique @db.VarChar(255)
  phone              String?             @db.VarChar(30)
  passwordHash       String              @map("password_hash") @db.VarChar(255)
  role               PlatformAdminRole   @default(OPERATIONS)
  status             PlatformAdminStatus @default(ACTIVE)
  department         String?             @db.VarChar(100)
  mustChangePassword Boolean             @default(true) @map("must_change_password")
  passwordChangedAt  DateTime?           @map("password_changed_at") @db.Timestamptz(6)
  emailVerifiedAt    DateTime?           @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt    DateTime?           @map("phone_verified_at") @db.Timestamptz(6)
  twoFactorEnabled   Boolean             @default(false) @map("two_factor_enabled")
  totpSecretEnc      String?             @map("totp_secret_enc") @db.Text
  recoveryCodeHashes Json?               @map("recovery_code_hashes") @db.JsonB
  lastLoginAt        DateTime?           @map("last_login_at") @db.Timestamptz(6)
  createdByAdminId   String?             @map("created_by_admin_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions PlatformAdminSession[]
  passkeys PlatformAdminPasskey[]

  @@index([role, status])
  @@map("platform_admins")
}

model PlatformAdminPasskey {
  id            String    @id @default(uuid()) @db.Uuid
  adminId       String    @map("admin_id") @db.Uuid
  credentialId  String    @unique @map("credential_id") @db.VarChar(512)
  publicKeySpki String    @map("public_key_spki") @db.Text
  algorithm     Int       @default(-7)
  deviceName    String    @default("Passkey Device") @map("device_name") @db.VarChar(120)
  counter       Int       @default(0)
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("platform_admin_passkeys")
}

model PlatformAdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  adminId     String    @map("admin_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(255)
  mfaVerified Boolean   @default(false) @map("mfa_verified")
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  userAgent   String?   @map("user_agent") @db.Text
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("platform_admin_sessions")
}
