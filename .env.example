# ==============================================================================
# School Management SaaS — Environment Configuration Template
# Copy this file to `.env.local` for local development.
# Never commit real production secrets, passwords, DSNs, or cryptographic keys.
# ==============================================================================

# ==============================================================================
# 1. CORE RUNTIME (Required)
# ==============================================================================
NODE_ENV=""
NEXT_PUBLIC_APP_NAME=""
NEXT_PUBLIC_APP_URL=""

# ==============================================================================
# 2. DATABASE & SUPABASE CONFIGURATION (Required for database operations)
# ==============================================================================
# Application runtime pooled connection (for Vercel/serverless use IPv4 Supavisor Transaction Pooler :6543 with ?pgbouncer=true&connection_limit=1)
DATABASE_URL=""

# Session pooler or direct connection for Prisma schema migrations (for IPv4 hosts use Session Pooler :5432)
DIRECT_URL=""

# Optional Supabase client / middleware integration
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Local Docker container credentials (used only by docker-compose.yml)
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""
POSTGRES_PORT=""

# ==============================================================================
# 3. REDIS & BACKGROUND JOBS (Required for cache, rate-limits, and BullMQ queues)
# ==============================================================================
# Upstash Serverless Redis (REST API - required for Vercel/serverless caching, rate limits, and health checks)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional Vercel KV fallback aliases (supported automatically if set)
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""

# Standard TCP Redis (Used for BullMQ background job queues and local Docker Redis)
REDIS_URL=""
REDIS_PORT=""

# ==============================================================================
# 4. AUTHENTICATION & SESSION SECURITY (Required for user authentication)
# ==============================================================================
# Generate a secure 32+ byte key with: openssl rand -base64 32
AUTH_SECRET=""
# Session lifetime in seconds (28800 = 8 hours recommended for school staff/admins)
AUTH_SESSION_TTL_SECONDS=""
AUTH_COOKIE_NAME=""

# ==============================================================================
# 5. OBSERVABILITY & ERROR REPORTING (GlitchTip / Sentry-compatible & Logging)
# ==============================================================================
# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=""
# GlitchTip / Sentry-compatible DSN (leave blank to log locally without external uploads)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_GLITCHTIP_TRACES_SAMPLE_RATE="0.01"
# GlitchTip Source Maps Upload (Optional CI/build credentials)
SENTRY_URL=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""

# ==============================================================================
# 6. EMAIL NOTIFICATIONS (Resend / Brevo / SMTP)
# ==============================================================================
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
RESEND_FROM_NAME=""
EMAIL_PROVIDER=""
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM=""
BREVO_API_KEY=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""

# ==============================================================================
# 7. SMS / OTP NOTIFICATIONS (Renflair / MSG91 / Twilio)
# ==============================================================================
SMS_PROVIDER=""
RENFLAIR_API_KEY=""

# ==============================================================================
# 8. OBJECT STORAGE & MEDIA CDN (ImageKit active, Cloudflare R2-ready)
# ==============================================================================
STORAGE_PROVIDER="auto"
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_URL_ENDPOINT=""
IMAGEKIT_BASE_FOLDER="/scholonix"
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=""
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=""

# Future Cloudflare R2 / S3-compatible object storage
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""

# ==============================================================================
# 9. PAYMENT GATEWAYS (Optional / Integration-specific)
# ==============================================================================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
