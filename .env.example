# ==============================================================================
# School Management SaaS — Environment Configuration Template
# Copy this file to `.env.local` for local development.
# Never commit real production secrets, passwords, or cryptographic keys.
# ==============================================================================

# ==============================================================================
# 1. CORE RUNTIME (Required)
# ==============================================================================
NODE_ENV=""
NEXT_PUBLIC_APP_NAME=""
NEXT_PUBLIC_APP_URL=""

# ==============================================================================
# 2. DATABASE CONFIGURATION (Required for database operations)
# ==============================================================================
# Application runtime pooled connection (non-superuser role, subject to RLS)
DATABASE_URL=""

# Direct DDL connection for Prisma schema migrations (bypasses connection pooler)
DIRECT_URL=""

# Local Docker container credentials (used only by docker-compose.yml)
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""
POSTGRES_PORT=""

# ==============================================================================
# 3. REDIS & BACKGROUND JOBS (Required for cache, rate-limits, and BullMQ queues)
# ==============================================================================
REDIS_URL=""
REDIS_PORT=""

# ==============================================================================
# 4. AUTHENTICATION & SESSION SECURITY (Required for user authentication)
# ==============================================================================
# Generate a secure 32+ byte key with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_SESSION_TTL_SECONDS=""
AUTH_COOKIE_NAME=""

# ==============================================================================
# 5. OBSERVABILITY & ERROR REPORTING (Optional in development, recommended in prod)
# ==============================================================================
LOG_LEVEL=""
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""

# ==============================================================================
# 6. EMAIL NOTIFICATIONS (Optional / Integration-specific)
# ==============================================================================
EMAIL_PROVIDER=""
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""

# ==============================================================================
# 7. SMS / OTP NOTIFICATIONS (Renflair / MSG91 / Twilio)
# ==============================================================================
SMS_PROVIDER="renflair"
RENFLAIR_API_KEY=""

# ==============================================================================
# 8. OBJECT STORAGE (S3-compatible storage for tenant files, exports, media)
# ==============================================================================
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""

# ==============================================================================
# 9. PAYMENT GATEWAYS (Optional / Integration-specific)
# ==============================================================================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
