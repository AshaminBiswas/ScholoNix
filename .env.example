# ==============================================================================
# School Management SaaS — Environment Configuration Template
# Copy this file to `.env.local` for local development.
# Never commit real production secrets, passwords, or cryptographic keys.
# ==============================================================================

# ==============================================================================
# 1. CORE RUNTIME (Required)
# ==============================================================================
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="ScholoNix"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# 2. DATABASE CONFIGURATION (Required for database operations)
# ==============================================================================
# Application runtime pooled connection (non-superuser role, subject to RLS)
DATABASE_URL="postgresql://school_app:replace_me@localhost:5432/school_saas?schema=public"

# Direct DDL connection for Prisma schema migrations (bypasses connection pooler)
DIRECT_URL="postgresql://school_migrator:replace_me@localhost:5432/school_saas?schema=public"

# Local Docker container credentials (used only by docker-compose.yml)
POSTGRES_USER="school_app"
POSTGRES_PASSWORD="school_dev_password"
POSTGRES_DB="school_saas"
POSTGRES_PORT="5432"

# ==============================================================================
# 3. REDIS & BACKGROUND JOBS (Required for cache, rate-limits, and BullMQ queues)
# ==============================================================================
REDIS_URL="redis://localhost:6379"
REDIS_PORT="6379"

# ==============================================================================
# 4. AUTHENTICATION & SESSION SECURITY (Required for user authentication)
# ==============================================================================
# Generate a secure 32+ byte key with: openssl rand -base64 32
AUTH_SECRET="replace_with_at_least_32_byte_random_secret_for_sessions"
AUTH_SESSION_TTL_SECONDS="28800"
AUTH_COOKIE_NAME="__Host-school_session"

# ==============================================================================
# 5. OBSERVABILITY & ERROR REPORTING (Optional in development, recommended in prod)
# ==============================================================================
LOG_LEVEL="info"
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""

# ==============================================================================
# 6. EMAIL NOTIFICATIONS (Optional / Integration-specific)
# ==============================================================================
EMAIL_PROVIDER="smtp"
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="noreply@example.com"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""

# ==============================================================================
# 7. SMS / PUSH NOTIFICATIONS
# ==============================================================================
# Options: "fast2sms" (India recommended) | "twilio" | "2factor" | "msg91" | "console"
SMS_PROVIDER="fast2sms"

# --- Fast2SMS Configuration (Official Send OTP API) ---
# Reference: https://docs.fast2sms.com/reference/send-otp
# 1. Sign up at https://www.fast2sms.com -> Dev API to get your Authorization Key
FAST2SMS_API_KEY="your_fast2sms_api_key_here"

# 2. In Fast2SMS Dashboard, go to "Smart OTP" -> "OTP Template List"
# Copy your 10-character unique OTP Template ID (e.g., "AB12CD34EF")
FAST2SMS_OTP_ID="your_10_character_otp_id_here"

# Optional: route selection (defaults to "otp_api" which calls /dev/otp/send)
# - "otp_api" (default): Dedicated Send OTP API (https://docs.fast2sms.com/reference/send-otp)
# - "dlt": If using TRAI DLT Header + Template Message ID on /dev/bulkV2
FAST2SMS_ROUTE="otp_api"

# Optional DLT fields (only required if FAST2SMS_ROUTE="dlt"):
FAST2SMS_SENDER_ID="FSTSMS"
FAST2SMS_TEMPLATE_ID=""

# --- MSG91 Configuration (Official SendOTP & Verify OTP API) ---
# Reference: https://docs.msg91.com/otp/llms.txt
# To use MSG91 for OTP: set SMS_PROVIDER="msg91"
# 1. Sign up / log in at https://msg91.com -> Authkey
MSG91_AUTH_KEY="your_msg91_authkey_here"

# 2. In MSG91 Dashboard -> OTP -> Templates, create an OTP Template with ##OTP##
MSG91_OTP_TEMPLATE_ID="your_msg91_otp_template_id_here"

# --- Twilio Configuration (Alternative / Global) ---
# TWILIO_ACCOUNT_SID="your_twilio_account_sid"
# TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"



# ==============================================================================
# 8. OBJECT STORAGE (S3-compatible storage for tenant files, exports, media)
# ==============================================================================
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""

# ==============================================================================
# 9. PAYMENT GATEWAYS (Optional / Integration-specific)
# ==============================================================================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
